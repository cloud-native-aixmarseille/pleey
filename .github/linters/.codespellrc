[codespell]
# Skip third-party/generated paths and French-locale content files.
# NotIn is a Kubernetes label-selector operator.
ignore-words-list = afterAll,bootstrapPin,initiales,notin,previousY
skip = .git,*.svg,**/package-lock.json,**/application/*/dist/**,**/application/*/node_modules/**,**/application/*/coverage/**,**/application/*/junit.xml,**/charts/dist/**,**/charts/application/crds/**,**/apps/api/src/i18n/fr/*.json,**/apps/web/src/presentation/**/i18n/fr.ts,**/packages/contracts/i18n/fr.ts,**/docs/usage/fr/**.md
