# Runtime settings are explicit: missing required values fail startup.
# Database
DATABASE_URL=postgresql://quizuser:quizpass@localhost:5432/quizdb?schema=public

# Integration tests (Vitest e2e) MUST use a different database than dev.
DATABASE_URL_TEST=postgresql://quizuser:quizpass@localhost:5432/quizdb_test?schema=public

# JWT
JWT_ACCESS_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=1209600
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me
JWT_SECRET=your_jwt_secret_change_me

# Server
APP_VERSION=dev
GRAPHQL_GRAPHIQL_ENABLED=true
GRAPHQL_INTROSPECTION_ENABLED=true
# Omit the output path to keep the generated schema in memory.
GRAPHQL_SCHEMA_OUTPUT_PATH=src/schema.gql
I18N_WATCH_ENABLED=true
NODE_ENV=development
PARTY_SESSION_RECOVERY_WINDOW_MS=300000
PLAYABLE_CONTENT_IMPORT_MAX_FILE_SIZE_BYTES=5242880
PORT=3001

# CORS
CORS_ORIGIN=*

# OpenTelemetry (console settings are required; the exporter endpoint and headers are optional)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS='{"Authorization":"Bearer YOUR_TOKEN"}'
OTEL_CONSOLE_DIAGNOSTICS_ENABLED=false
OTEL_CONSOLE_EXPORTERS_ENABLED=false
OTEL_CONSOLE_LOGS_ENABLED=false

# Password recovery (ADR 0009); enable HTTPS enforcement and SMTP TLS for public deployments.
FRONTEND_REQUIRE_HTTPS=false
FRONTEND_URL=http://pleey.localhost
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
# Host-only SMTP setup: docs/technical/development/backend/operations.md#development-mail-capture
SMTP_FROM="Pleey <noreply@pleey.localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD= (or SMTP_PASSWORD_FILE)

# Dedicated signing key shared across replicas; replace in production (CAP_SECRET_FILE supported).
CAP_SECRET=pleey-local-development-captcha-secret-replace-in-production
VALKEY_URL=redis://localhost:6379

# Required comma-separated CIDRs of ingress proxies you control; explicitly empty trusts only the socket peer.
TRUSTED_PROXY_CIDRS=

# Quiz media (ADR 0012). Development S3 endpoint is loopback-only; delivery uses Traefik.
# Install ffmpeg, ffprobe and prlimit for host backend workflows.
MEDIA_STORAGE_ENDPOINT=http://localhost:8333
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_BUCKET=pleey-media
MEDIA_STORAGE_ACCESS_KEY_ID=pleey-media-dev
MEDIA_STORAGE_SECRET_ACCESS_KEY=pleey-media-development-secret
# Both credentials support the _FILE convention.
MEDIA_STORAGE_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://media.pleey.localhost/pleey-media
MEDIA_REQUIRE_HTTPS=false
MEDIA_ACCESS_TTL_SECONDS=300
MEDIA_PROCESSING_TIMEOUT_MS=120000
MEDIA_PROCESSING_CONCURRENCY=1
MEDIA_PROCESSING_MEMORY_LIMIT_MB=1024
