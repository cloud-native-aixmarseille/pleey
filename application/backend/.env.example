# Database
DATABASE_URL=postgresql://quizuser:quizpass@localhost:5432/quizdb?schema=public

# Integration tests (Vitest e2e) MUST use a different database than dev.
DATABASE_URL_TEST=postgresql://quizuser:quizpass@localhost:5432/quizdb_test?schema=public

# JWT
JWT_EXPIRATION=24h
JWT_SECRET=your_jwt_secret_change_me

# Server
APP_VERSION=dev
NODE_ENV=development
PORT=3001

# CORS
CORS_ORIGIN=*

# OpenTelemetry (Optional - console exporters and console log mirroring are disabled by default)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS='{"Authorization":"Bearer YOUR_TOKEN"}'
# OTEL_CONSOLE_DIAGNOSTICS_ENABLED=false
# OTEL_CONSOLE_EXPORTERS_ENABLED=false
# OTEL_CONSOLE_LOGS_ENABLED=false

# Password recovery (ADR 0009); production requires HTTPS and SMTP TLS.
FRONTEND_URL=http://pleey.localhost
# Host-only SMTP setup: docs/technical/development/backend/operations.md#development-mail-capture
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=Pleey <noreply@pleey.localhost>
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
# SMTP_USER=
# SMTP_PASSWORD= (or SMTP_PASSWORD_FILE)
