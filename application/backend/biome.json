{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "root": false,
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "prisma/**",
      "prisma.config.ts",
      "vitest.config.ts",
      "vitest.config.mts",
      "!dist",
      "!dist-types",
      "!coverage",
      "!lcov-report"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "includes": ["**", "!src/schema.gql"],
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "noProcessEnv": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/app/config", "**/app/config/**", "src/app/config", "src/app/config/**"],
                "message": "Only the app layer may import app config readers. Inject derived configuration values into other layers via providers."
              }
            ]
          }
        },
        "useImportType": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "includes": ["**", "!src/schema.gql"],
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.{ts,tsx,js,jsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/game/party/*/**",
                      "!**/game/party/enums/**",
                      "!**/game/party/errors/**",
                      "!**/game/party/host/**",
                      "!**/game/party/player/**",
                      "!**/game/party/shared/**"
                    ],
                    "message": "Only **/game/party/{host,player,shared}/** is allowed under game/party."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app/config/**/*.ts",
        "src/domain/**/services/*identifier.ts",
        "src/**/*.spec.ts",
        "src/**/*.int.spec.ts",
        "test/**/*.ts",
        "prisma/**/*.ts",
        "prisma.config.ts",
        "vitest.config.ts",
        "vitest.config.mts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    },
    {
      "includes": ["src/presentation/game/types/shared/**/*.{ts,tsx,js,jsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/game/types/quiz/**", "**/game/types/prediction/**"],
                    "message": "Game types shared layer must not import from game-type specific layers (quiz/, prediction/)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/presentation/game/party/shared/**/*.{ts,tsx,js,jsx}",
        "!!src/presentation/game/party/shared/screens/components/party-screen-content.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/game/party/host/**", "**/game/party/player/**"],
                    "message": "Party shared layer must not import from host/ or player/ layers. Shared must stay role-agnostic."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/application/**/*.ts", "src/domain/**/*.ts"],
      "plugins": ["./biome/plugins/application-domain-boundaries.grit"]
    },
    {
      "includes": [
        "src/application/**/*.ts",
        "src/domain/**/*.ts",
        "src/infrastructure/**/*.ts",
        "src/presentation/**/*.ts",
        "!!src/**/*.spec.ts",
        "!!src/**/*.test.ts",
        "!!src/**/*.int.spec.ts"
      ],
      "plugins": ["./biome/plugins/domain-error-throw-shape.grit"]
    },
    {
      "includes": [
        "src/application/**/*.ts",
        "src/domain/**/*.ts",
        "src/infrastructure/**/*.ts",
        "src/presentation/**/*.ts"
      ],
      "plugins": ["./biome/plugins/identifier-boundaries.grit"]
    },
    {
      "includes": ["src/presentation/**/*.ts"],
      "plugins": ["./biome/plugins/presentation-boundaries.grit"]
    },
    {
      "includes": ["src/infrastructure/telemetry/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/domain/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestjs/common"],
                    "importNamePattern": "Exception",
                    "message": "Domain layer must not import NestJS exceptions. Throw domain errors and translate them in the application/presentation layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/application/**/use-cases/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestjs/common"],
                    "importNamePattern": "Exception",
                    "message": "Use cases must not import framework-specific exceptions. Throw ApplicationError/domain errors and map them in infrastructure filters."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/application/workspace/dashboard/**/*.ts"],
      "plugins": ["./biome/plugins/dashboard-application-boundaries.grit"]
    }
  ]
}
