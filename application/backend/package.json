{
  "name": "quiz-backend",
  "version": "0.0.1",
  "description": "Pleey backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "biome format --config-path biome.json --write .",
    "lint": "npm run _lint:pre && npm run _lint:biome && npm run _lint:post",
    "lint:fix": "npm run _lint:pre && npm run _lint:biome:fix && npm run _lint:post",
    "lint:ci": "npm run _lint:pre && npm run _lint:biome:ci && npm run _lint:post",
    "_lint:biome": "biome lint --config-path biome.json --error-on-warnings .",
    "_lint:biome:ci": "biome ci --config-path biome.json --error-on-warnings --reporter=json --reporter-file=biome-report.json .",
    "_lint:biome:fix": "biome check --config-path biome.json --error-on-warnings --write .",
    "_lint:knip": "knip --config knip.json",
    "_lint:post": "node ./scripts/check-domain-errors.mjs",
    "_lint:pre": "node ./scripts/check-naming.mjs && node ./scripts/check-di-instantiation.mjs && node ./scripts/check-invariant-arguments.mjs && npm run _lint:unused-exports && npm run _lint:test-only && npm run _lint:test-conventions && npm run _lint:knip",
    "_lint:test-conventions": "node ./scripts/check-test-conventions.mjs ./src ./test",
    "_lint:test-only": "node ./scripts/check-test-only-exports.mjs ./src",
    "_lint:unused-exports": "node ./scripts/find-unused-exports.mjs ./src",
    "start": "nest start",
    "start:dev": "nest start --watch --watchAssets",
    "start:debug": "nest start --debug --watch --watchAssets",
    "start:prod": "node dist/src/app/main",
    "seed": "ts-node --esm --transpile-only prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "npm run db:migrate && npm run db:generate && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest --config ./test/vitest.config.e2e.mts",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/websockets": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.14.2",
    "graphql-upload-minimal": "^1.6.4",
    "graphql-ws": "^6.2.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-otel": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/config": "^7.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "knip": "^6.34.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@apollo/protobufjs": true,
    "@prisma/engines@7.9.1": true,
    "@scarf/scarf": true,
    "prisma@7.9.1": true,
    "protobufjs@7.6.5": true
  }
}
