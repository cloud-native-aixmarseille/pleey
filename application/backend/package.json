{
  "name": "@pleey/api",
  "version": "0.0.1",
  "description": "Pleey backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --config-path biome.json --write .",
    "lint": "pnpm _lint:pre && pnpm _lint:biome && pnpm _lint:post",
    "lint:fix": "pnpm _lint:pre && pnpm _lint:biome:fix && pnpm _lint:post",
    "lint:ci": "pnpm _lint:pre && pnpm _lint:biome:ci && pnpm _lint:post",
    "_lint:biome": "biome lint --config-path biome.json --error-on-warnings .",
    "_lint:biome:ci": "biome ci --config-path biome.json --error-on-warnings --reporter=sarif --reporter-file=biome-report.sarif .",
    "_lint:biome:fix": "biome check --config-path biome.json --error-on-warnings --write .",
    "_lint:knip": "knip --config knip.json",
    "_lint:post": "node ./scripts/check-domain-errors.mjs",
    "_lint:pre": "node ./scripts/check-shared-package.mjs && node ./scripts/check-shared-translations.mjs && pnpm _lint:resolvers && pnpm _lint:pagination && node ./scripts/check-naming.mjs && node ./scripts/check-di-instantiation.mjs && node ./scripts/check-module-exports.mjs && node ./scripts/check-invariant-arguments.mjs && pnpm _lint:unused-exports && pnpm _lint:test-only && pnpm _lint:test-conventions && pnpm _lint:knip",
    "_lint:test-conventions": "node ./scripts/check-test-conventions.mjs ./src ./test",
    "_lint:test-only": "node ./scripts/check-test-only-exports.mjs ./src",
    "_lint:unused-exports": "node ./scripts/find-unused-exports.mjs ./src",
    "_lint:resolvers": "node ./scripts/check-resolver-use-cases.mjs",
    "_lint:pagination": "node ./scripts/check-pagination.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch --watchAssets",
    "start:debug": "nest start --debug --watch --watchAssets",
    "start:prod": "node dist/app/main",
    "seed": "tsc -p prisma/tsconfig.seed.json && node dist/seed/prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "pnpm db:migrate && pnpm db:generate && pnpm seed",
    "test": "vitest run",
    "test:import-templates": "vitest run --config ./test/vitest.config.import-templates.mts",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest --config ./test/vitest.config.e2e.mts",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
    "docs:generate": "node scripts/generate-usage-reference.mjs",
    "docs:check": "node scripts/generate-usage-reference.mjs --check"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@aws-sdk/util-format-url": "^3.972.60",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/websockets": "^12.5.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@pleey/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@smithy/protocol-http": "^5.6.2",
    "bcryptjs": "^3.0.3",
    "capjs-core": "0.1.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^17.1.0",
    "graphql-upload-minimal": "^1.6.5",
    "graphql-ws": "^6.4.3",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.10.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@prisma/config": "^7.10.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "knip": "^6.45.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1",
    "mysql2": "3.24.4",
    "@graphql-tools/utils": "12.0.2",
    "nestjs-i18n": {
      "chokidar": "5.0.0"
    }
  },
  "allowScripts": {
    "@apollo/protobufjs": true,
    "@prisma/engines@7.10.1": true,
    "@scarf/scarf": true,
    "prisma@7.10.1": true,
    "protobufjs@7.6.6": true
  }
}
