{
  "name": "pleey-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "lint": "npm run _lint:pre && npm run _lint:typecheck && npm run _lint:biome && npm run _lint:post",
    "lint:fix": "npm run _lint:pre && npm run _lint:biome:fix && npm run _lint:typecheck && npm run _lint:post",
    "lint:ci": "npm run _lint:pre && npm run _lint:typecheck && npm run _lint:biome:ci && npm run _lint:post",
    "_lint:biome": "biome lint --config-path biome.json --error-on-warnings .",
    "_lint:biome:ci": "biome ci --config-path biome.json --error-on-warnings --reporter=sarif --reporter-file=biome-report.sarif .",
    "_lint:biome:fix": "biome check --config-path biome.json --error-on-warnings --write .",
    "_lint:graphql-usage": "node ./scripts/check-graphql-usage.mjs",
    "_lint:knip": "knip --config knip.json",
    "_lint:post": "node ./scripts/check-domain-errors.mjs",
    "_lint:pre": "node ./scripts/check-shared-package.mjs && node scripts/check-user-docs.mjs && npm run _lint:pagination && node ./scripts/check-presentation-screens.mjs && node ./scripts/check-create-edit-form-factorization.mjs && node ./scripts/check-naming.mjs && node ./scripts/check-di-instantiation.mjs && node ./scripts/check-module-exports.mjs && node ./scripts/check-invariant-arguments.mjs && npm run _lint:graphql-usage && npm run _lint:unused-exports && npm run _lint:test-only && npm run _lint:test-conventions && npm run _lint:knip",
    "_lint:test-conventions": "node ./scripts/check-test-conventions.mjs ./src ./test",
    "_lint:test-only": "node ./scripts/check-test-only-exports.mjs ./src",
    "_lint:typecheck": "tsc --noEmit -p tsconfig.json",
    "_lint:unused-exports": "node ./scripts/find-unused-exports.mjs ./src",
    "_lint:pagination": "node ./scripts/check-pagination.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "docs:generate": "node scripts/generate-usage-reference.mjs",
    "docs:check": "node scripts/generate-usage-reference.mjs --check"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@cap.js/wasm": "0.0.8",
    "@cap.js/widget": "0.1.63",
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@pleey/domain": "file:../shared",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-virtual": "^3.14.26",
    "apollo-upload-client": "^20.0.0",
    "driver.js": "^1.14.0",
    "graphql": "^17.1.0",
    "i18next": "^27.1.5",
    "inversify": "^8.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.5",
    "reflect-metadata": "^0.2.2",
    "socket.io-client": "^4.8.4",
    "unique-username-generator": "^1.5.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "github-slugger": "^2.0.0",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "markdown-it": "^15.0.3",
    "postcss": "^8.5.33",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
