{
  "name": "@pleey/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "lint": "pnpm _lint:pre && pnpm _lint:typecheck && pnpm _lint:biome && pnpm _lint:post",
    "lint:fix": "pnpm _lint:pre && pnpm _lint:biome:fix && pnpm _lint:typecheck && pnpm _lint:post",
    "lint:ci": "pnpm _lint:pre && pnpm _lint:typecheck && pnpm _lint:biome:ci && pnpm _lint:post",
    "_lint:biome": "biome lint --config-path biome.json --error-on-warnings .",
    "_lint:biome:ci": "biome ci --config-path biome.json --error-on-warnings --reporter=sarif --reporter-file=biome-report.sarif .",
    "_lint:biome:fix": "biome check --config-path biome.json --error-on-warnings --write .",
    "_lint:graphql-usage": "node ./scripts/check-graphql-usage.mjs",
    "_lint:knip": "knip --config knip.json",
    "_lint:post": "node ./scripts/check-domain-errors.mjs",
    "_lint:pre": "node ./scripts/check-shared-package.mjs && node scripts/check-user-docs.mjs && pnpm _lint:pagination && node ./scripts/check-presentation-screens.mjs && node ./scripts/check-create-edit-form-factorization.mjs && node ./scripts/check-naming.mjs && node ./scripts/check-di-instantiation.mjs && node ./scripts/check-module-exports.mjs && node ./scripts/check-invariant-arguments.mjs && pnpm _lint:graphql-usage && pnpm _lint:unused-exports && pnpm _lint:test-only && pnpm _lint:test-conventions && pnpm _lint:knip",
    "_lint:test-conventions": "node ./scripts/check-test-conventions.mjs ./src ./test",
    "_lint:test-only": "node ./scripts/check-test-only-exports.mjs ./src",
    "_lint:typecheck": "tsc --noEmit -p tsconfig.json",
    "_lint:unused-exports": "node ./scripts/find-unused-exports.mjs ./src",
    "_lint:pagination": "node ./scripts/check-pagination.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "docs:generate": "node scripts/generate-usage-reference.mjs",
    "docs:check": "node scripts/generate-usage-reference.mjs --check"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@cap.js/wasm": "0.0.8",
    "@cap.js/widget": "0.1.63",
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@pleey/contracts": "workspace:*",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-virtual": "^3.14.26",
    "apollo-upload-client": "^20.0.0",
    "better-auth": "1.7.27",
    "driver.js": "^1.14.0",
    "graphql": "^16.15.0",
    "i18next": "^27.1.5",
    "inversify": "^8.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.5",
    "reflect-metadata": "^0.2.2",
    "socket.io-client": "^4.8.4",
    "unique-username-generator": "^1.5.1",
    "uuid": "^14.0.3",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@graphql-codegen/cli": "7.0.0",
    "@graphql-codegen/typed-document-node": "7.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "github-slugger": "^2.0.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "markdown-it": "^15.0.3",
    "postcss": "^8.5.33",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
