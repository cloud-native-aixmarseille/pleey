{
  "name": "@pleey/contracts",
  "version": "0.0.0",
  "description": "Pleey shared frontend/backend domain contracts",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "files": [
    "shared/",
    "identifier/",
    "identity/",
    "organization/",
    "project/",
    "game/",
    "i18n/",
    "media/",
    "errors/",
    "party/",
    "theme/",
    "dist/",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/empty.d.ts",
      "import": "./dist/empty.js",
      "default": "./dist/empty.js"
    },
    "./shared/primitives": {
      "types": "./dist/shared/primitives/index.d.ts",
      "import": "./dist/shared/primitives/index.js",
      "default": "./dist/shared/primitives/index.js"
    },
    "./identifier": {
      "types": "./dist/identifier/index.d.ts",
      "import": "./dist/identifier/index.js",
      "default": "./dist/identifier/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js",
      "default": "./dist/identity/index.js"
    },
    "./organization": {
      "types": "./dist/organization/index.d.ts",
      "import": "./dist/organization/index.js",
      "default": "./dist/organization/index.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "import": "./dist/project/index.js",
      "default": "./dist/project/index.js"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "import": "./dist/game/index.js",
      "default": "./dist/game/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "default": "./dist/i18n/index.js"
    },
    "./party": {
      "types": "./dist/party/index.d.ts",
      "import": "./dist/party/index.js",
      "default": "./dist/party/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./package.json": "./package.json"
  }
}
