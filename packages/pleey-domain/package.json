{
  "name": "@pleey/domain",
  "version": "0.0.0",
  "description": "Pleey shared frontend/backend domain contracts",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "shared/",
    "identity/",
    "organization/",
    "project/",
    "game/",
    "i18n/",
    "media/",
    "errors/",
    "party/",
    "theme/",
    "empty.js",
    "empty.cjs",
    "empty.d.ts",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./empty.d.ts",
      "import": "./empty.js",
      "require": "./empty.cjs",
      "default": "./empty.js"
    },
    "./shared/primitives": {
      "types": "./shared/primitives/index.d.ts",
      "import": "./shared/primitives/index.js",
      "require": "./shared/primitives/index.js",
      "default": "./shared/primitives/index.js"
    },
    "./identity": {
      "types": "./identity/index.d.ts",
      "import": "./identity/index.js",
      "require": "./identity/index.js",
      "default": "./identity/index.js"
    },
    "./organization": {
      "types": "./organization/index.d.ts",
      "import": "./organization/index.js",
      "require": "./organization/index.js",
      "default": "./organization/index.js"
    },
    "./project": {
      "types": "./project/index.d.ts",
      "import": "./project/index.js",
      "require": "./project/index.js",
      "default": "./project/index.js"
    },
    "./game": {
      "types": "./game/index.d.ts",
      "import": "./game/index.js",
      "require": "./game/index.js",
      "default": "./game/index.js"
    },
    "./i18n": {
      "types": "./i18n/index.d.ts",
      "import": "./i18n/index.js",
      "require": "./i18n/index.js",
      "default": "./i18n/index.js"
    },
    "./party": {
      "types": "./party/index.d.ts",
      "import": "./party/index.js",
      "require": "./party/index.js",
      "default": "./party/index.js"
    },
    "./theme": {
      "types": "./theme/index.d.ts",
      "import": "./theme/index.js",
      "require": "./theme/index.js",
      "default": "./theme/index.js"
    },
    "./media": {
      "types": "./media/index.d.ts",
      "import": "./media/index.js",
      "require": "./media/index.js",
      "default": "./media/index.js"
    },
    "./errors": {
      "types": "./errors/index.d.ts",
      "import": "./errors/index.js",
      "require": "./errors/index.js",
      "default": "./errors/index.js"
    },
    "./package.json": "./package.json"
  }
}
